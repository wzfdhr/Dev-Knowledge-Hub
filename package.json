{
  "name": "dev-knowledge-hub",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "dev:e2e-server": "tsx src/server/e2e-main.ts",
    "build": "vite build && tsc -p tsconfig.node.json",
    "start": "node dist/server/server/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx src/db/migrate.ts",
    "mcp:stdio": "tsx src/server/mcp-stdio.ts",
    "test:e2e": "playwright test",
    "test:integration": "vitest run src/server/persistence/postgres-knowledge.integration.test.ts",
    "acceptance": "vitest run acceptance/real-query.acceptance.test.ts",
    "delivery:verify": "node scripts/verify-delivery.mjs",
    "licenses:check": "node scripts/licenses-check.mjs",
    "licenses:report": "node scripts/licenses-check.mjs --report",
    "secrets:scan": "node scripts/secrets-scan.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^9.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-query": "^5.101.2",
    "ai": "^7.0.22",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
