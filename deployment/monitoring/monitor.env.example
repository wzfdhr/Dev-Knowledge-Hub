# Copy to /etc/devkh-monitor/monitor.env and keep permissions at 0600.
COMPOSE_DIR=/opt/dev-knowledge-hub
COMPOSE_PROJECT_NAME=dev-knowledge-hub
APP_HEALTH_URL=http://127.0.0.1:3000/api/health
BACKUP_ENV_FILE=/etc/devkh-backup/backup.env
MONITOR_STATE_DIR=/var/lib/devkh-monitor
DISK_PATH=/var/lib/docker
MAX_DISK_USED_PERCENT=85
MAX_BACKUP_AGE_SECONDS=108000
MAX_IMPORT_FAILURE_RATE_PERCENT=25
