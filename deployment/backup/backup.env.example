# Copy to /etc/devkh-backup/backup.env and replace every placeholder there.
COMPOSE_DIR=/opt/dev-knowledge-hub
COMPOSE_PROJECT_NAME=dev-knowledge-hub
SNAPSHOT_VOLUME=dev-knowledge-hub_snapshot_data
REPOSITORY_VOLUME=dev-knowledge-hub_repository_mirrors
UPLOADED_SOURCES_VOLUME=dev-knowledge-hub_uploaded_sources
UPLOAD_VOLUME=dev-knowledge-hub_upload_staging
ARTIFACT_VOLUME=dev-knowledge-hub_artifact_data
RESTIC_REPOSITORY=s3:https://replace-with-private-bucket.oss-cn-hangzhou.aliyuncs.com/devkh
RESTIC_PASSWORD_FILE=/etc/devkh-backup/restic-password
BACKUP_STATE_DIR=/var/lib/devkh-backup
RESTIC_CACHE_DIR=/var/lib/devkh-backup/restic-cache
AWS_ACCESS_KEY_ID=replace-with-dedicated-ram-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-dedicated-ram-access-key-secret
AWS_DEFAULT_REGION=cn-hangzhou
