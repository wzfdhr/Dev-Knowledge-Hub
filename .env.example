# Replace every placeholder before production use.
# Public DNS hostname for Caddy's automatic HTTPS certificate.
DEVKH_DOMAIN=hub.example.com
# Public HTTPS origin for links, cookies, and CSP. Keep its host equal to DEVKH_DOMAIN.
PUBLIC_BASE_URL=https://hub.example.com
# Address used for ACME expiry and incident notices.
ACME_EMAIL=operator@example.com
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://devkh:replace-with-a-random-database-password@127.0.0.1:5432/dev_knowledge_hub
DEVKH_MASTER_KEY=replace-with-output-of-openssl-rand-base64-32
DEVKH_SESSION_SECRET=replace-with-at-least-32-random-bytes
DEVKH_MCP_TOKEN=replace-with-a-token-created-in-settings
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Keep legacy as the only formal read path. Use shadow only for validated Phase F comparison work.
DEVKH_KNOWLEDGE_KERNEL_MODE=legacy
DEVKH_FRONTEND_KNOWLEDGE_MODE=legacy
DEVKH_SOURCE_STORAGE_MODE=legacy
DEVKH_PARSER_SOCKET_PATH=/run/devkh-parser/parser.sock
