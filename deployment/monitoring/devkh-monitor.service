[Unit]
Description=Dev Knowledge Hub operational monitor
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/devkh-monitor/monitor.env
ExecStart=/usr/local/lib/devkh-monitor/devkh-monitor.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/devkh-monitor
